{
  "description": "AI が部品 (seizou) の中身を書き換えないように、Write と Edit を止める (R20)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "python", "${CLAUDE_PLUGIN_ROOT}/hooks/guard_core.py"]
          }
        ]
      }
    ]
  }
}
