"""会社 ${id} の settings。seizou new が答えの YAML から作った。

鍵の値はこのファイルに書かない。鍵は同じ置き場の .env に置き、起動のときに環境変数として読む。
"""

import os
from pathlib import Path

from seizou.parts import PARTS

BASE_DIR = Path(__file__).resolve().parent


def _read_env(path):
    """.env の KEY=VALUE の行を環境変数に入れる (既にある環境変数が先)。# の行と空行は飛ばす。"""
    if not path.is_file():
        return
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        os.environ.setdefault(key.strip(), value.strip())


_read_env(BASE_DIR / ".env")

SECRET_KEY = os.environ["SECRET_KEY"]

# 開発は 1、本番は 0 (.env で切り替える)。1 のときは core の起動の検査が走る。
