# 本番は DEBUG=0 にする。
# 取引先の鍵は、人が SEIZOU_PARTNER_<相手の会社の id を大文字にした物>_SECRET= の形の行で足す。
SECRET_KEY=${secret_key}
DEBUG=1
# 開発機ではログインの画面を飛ばして管理者として開く (DEBUG=1 と runserver のときだけ効く)。本番は 0 にするか消す。
SEIZOU_DEV_AUTO_LOGIN=1
# 社内の PC で、LAN の中だけで http で開くなら SEIZOU_LAN_HTTP=1 の行を足す (起動は manage.py seizou_serve。外から届く置き場では足さない)。
# 本番で、上げたファイルを nginx に送らせるなら SEIZOU_FILE_DELIVERY=nginx (先に deploy/nginx-files.conf を nginx に読み込む)。
# 取引先から会話が届いたときのメールの知らせを使うなら、メールのサーバーを EMAIL_HOST=、ポートを EMAIL_PORT= (無ければ 587)、暗号化の方式を EMAIL_SECURITY= (starttls・ssl・none。無ければ starttls)、アカウントのパスワードを EMAIL_HOST_PASSWORD= の行で足す (この 4 つは画面では変えない。アカウント・差出人は設定の画面の「メールの知らせ」の「編集」で入れる)。
