# 本番は DEBUG=0 にする。
# 取引先の鍵は、人が SEIZOU_PARTNER_<相手の会社の id を大文字にした物>_SECRET= の形の行で足す。
SECRET_KEY=${secret_key}
DEBUG=1
# 開発機ではログインの画面を飛ばして管理者として開く (DEBUG=1 と runserver のときだけ効く)。本番は 0 にするか消す。
SEIZOU_DEV_AUTO_LOGIN=1
# 本番で、上げたファイルを nginx に送らせるなら SEIZOU_FILE_DELIVERY=nginx (先に deploy/nginx-files.conf を nginx に読み込む)。
